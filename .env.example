# Main reactor: a full JDK 21 or newer. CI should use a real JDK 21.
JAVA_AI_MAIN_JAVA_HOME=/path/to/jdk-21

# Legacy client: a full JDK 8 containing both bin/java and bin/javac.
JAVA_AI_JDK8_HOME=/path/to/jdk8

# Set only when running the explicit external health smoke.
JAVA_AI_EXTERNAL_BASE_URL=https://test.example.com

# Workspace release gates may require column tests. Standalone clones leave this at 0.
JAVA_AI_REQUIRE_COLUMN_TESTS=0

# Required only by explicit live model smoke and eval commands.
# Inject secrets from your shell, CI environment or company secret manager.
JAVA_AI_CHAT_API_KEY=
JAVA_AI_CHAT_BASE_URL=https://provider.example.com/v1
JAVA_AI_CHAT_MODEL=provider-model-name
JAVA_AI_EMBEDDING_MODEL=provider-embedding-model

# Required by authenticated HTTP evaluation and the rag-live profile.
JAVA_AI_EVAL_BEARER_TOKEN=
JAVA_AI_RETRIEVAL_BASE_URL=https://knowledge-test.example.com
JAVA_AI_RETRIEVAL_EVAL_BEARER_TOKEN=
JAVA_AI_JWT_ISSUER=https://identity.example.com
JAVA_AI_JWT_ALLOWED_ACTORS=customer-bff,ticket-agent-service
JAVA_AI_JWT_AUDIENCE=knowledge-service
JAVA_AI_JWT_ALLOWED_ACTORS=customer-bff,ticket-agent-service
JAVA_AI_JWT_JWK_SET_URI=
JAVA_AI_DEV_JWT_HMAC_SECRET=

# Required by the rag-live profile or external pgvector integration test.
JAVA_AI_POSTGRES_URL=jdbc:postgresql://database.example.com:5432/java_ai
JAVA_AI_POSTGRES_USER=java_ai
JAVA_AI_POSTGRES_PASSWORD=
JAVA_AI_EMBEDDING_DIMENSIONS=1536

# Optional report and local loopback port overrides.
JAVA_AI_LIVE_REPORT_PATH=
JAVA_AI_EVAL_PORT=18081
JAVA_AI_EVAL_COMMIT=
JAVA_AI_AGENT_LIVE_REPORT_PATH=

# Required only by Agent evaluation against a deployed Ticket Agent Service.
JAVA_AI_AGENT_BASE_URL=https://ticket-agent-test.example.com
JAVA_AI_AGENT_CREATE_TOKEN=
JAVA_AI_AGENT_RUN_TOKEN=
JAVA_AI_AGENT_READ_TOKEN=
JAVA_AI_AGENT_MAX_CONCURRENT_RUNS=16

# Release gate: set to 1 only when the deployed health environment is part of the release evidence.
JAVA_AI_RELEASE_REQUIRE_EXTERNAL=0

# Optional retrieval evaluation thresholds.
JAVA_AI_RETRIEVAL_EVAL_TOP_K=5
JAVA_AI_RETRIEVAL_MIN_RECALL=0.80
JAVA_AI_RETRIEVAL_MIN_HIT_RATE=0.90
JAVA_AI_RETRIEVAL_MIN_MRR=0.60
JAVA_AI_RETRIEVAL_MAX_DUPLICATE_RATE=0.02
JAVA_AI_RETRIEVAL_MAX_P95_MS=1500
