# Build toolchains
JAVA_AI_MAIN_JAVA_HOME=/path/to/jdk-21
JAVA_AI_JDK8_HOME=/path/to/jdk8

# OpenAI-compatible Chat and Embedding provider
# Inject real secrets through the shell, CI or a company secret manager.
JAVA_AI_CHAT_API_KEY=
JAVA_AI_CHAT_BASE_URL=https://provider.example.com/v1
JAVA_AI_CHAT_MODEL=provider-chat-model
JAVA_AI_EMBEDDING_MODEL=provider-embedding-model
JAVA_AI_EMBEDDING_DIMENSIONS=1536

# Knowledge Service PostgreSQL/pgvector
JAVA_AI_POSTGRES_URL=jdbc:postgresql://database.example.com:5432/java_ai_knowledge
JAVA_AI_POSTGRES_USER=java_ai_knowledge
JAVA_AI_POSTGRES_PASSWORD=
JAVA_AI_POSTGRES_POOL_SIZE=10
JAVA_AI_RETRIEVAL_TOP_K=6
JAVA_AI_RETRIEVAL_CANDIDATE_K=20

# Ticket Agent PostgreSQL
JAVA_AI_TICKET_DB_URL=jdbc:postgresql://database.example.com:5432/java_ai_ticket
JAVA_AI_TICKET_DB_USERNAME=java_ai_ticket
JAVA_AI_TICKET_DB_PASSWORD=
JAVA_AI_TICKET_DB_POOL_SIZE=10
JAVA_AI_CONFIRMATION_LEASE=30s
JAVA_AI_CONFIRMATION_TTL=15m
JAVA_AI_AGENT_MAX_STEPS=4
JAVA_AI_AGENT_MAX_CONCURRENT_RUNS=16
JAVA_AI_AGENT_ALLOWED_QUEUES=refund-review,tier-2

# Service identity
JAVA_AI_JWT_ISSUER=https://identity.example.com
JAVA_AI_JWT_AUDIENCE=knowledge-service
JAVA_AI_JWT_ALLOWED_ACTORS=customer-bff,ticket-agent-service
JAVA_AI_JWT_JWK_SET_URI=https://identity.example.com/.well-known/jwks.json
JAVA_AI_DEV_JWT_HMAC_SECRET=
JAVA_AI_CUSTOMER_JWT_ISSUER=https://identity.example.com
JAVA_AI_CUSTOMER_JWT_JWK_SET_URI=https://identity.example.com/.well-known/jwks.json
JAVA_AI_CUSTOMER_JWT_HMAC_SECRET=

# Customer BFF token exchange and service URLs
JAVA_AI_TOKEN_EXCHANGE_ENDPOINT=https://identity.example.com/oauth2/token
JAVA_AI_TOKEN_EXCHANGE_CLIENT_ID=customer-bff
JAVA_AI_TOKEN_EXCHANGE_CLIENT_SECRET=
JAVA_AI_KNOWLEDGE_BASE_URL=http://localhost:8081
JAVA_AI_TICKET_BASE_URL=http://localhost:8082

# Ticket Agent downstream Tool services
JAVA_AI_LEGACY_TOOL_BASE_URL=http://localhost:8090
JAVA_AI_DOWNSTREAM_TIMEOUT=3s
# The sample implements development-hmac for controlled integration only.
# Replace it with the company's service-token adapter before production.
JAVA_AI_DOWNSTREAM_TOKEN_MODE=development-hmac

# Real-model and evaluation commands
JAVA_AI_EVAL_BEARER_TOKEN=
JAVA_AI_RETRIEVAL_BASE_URL=https://knowledge-test.example.com
JAVA_AI_RETRIEVAL_EVAL_BEARER_TOKEN=
JAVA_AI_AGENT_BASE_URL=https://ticket-agent-test.example.com
JAVA_AI_AGENT_CREATE_TOKEN=
JAVA_AI_AGENT_RUN_TOKEN=
JAVA_AI_AGENT_READ_TOKEN=
JAVA_AI_LIVE_REPORT_PATH=
JAVA_AI_AGENT_LIVE_REPORT_PATH=
JAVA_AI_EVAL_PORT=18081
JAVA_AI_EVAL_COMMIT=

# Optional retrieval quality gates
JAVA_AI_RETRIEVAL_EVAL_TOP_K=5
JAVA_AI_RETRIEVAL_MIN_RECALL=0.80
JAVA_AI_RETRIEVAL_MIN_HIT_RATE=0.90
JAVA_AI_RETRIEVAL_MIN_MRR=0.60
JAVA_AI_RETRIEVAL_MAX_DUPLICATE_RATE=0.02
JAVA_AI_RETRIEVAL_MAX_P95_MS=1500

# External health evidence for the release gate
JAVA_AI_EXTERNAL_BASE_URL=https://test.example.com
JAVA_AI_RELEASE_REQUIRE_EXTERNAL=0
