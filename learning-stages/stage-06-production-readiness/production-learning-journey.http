@knowledgeBaseUrl = http://localhost:8081
@ticketBaseUrl = http://localhost:8082
@customerBaseUrl = http://localhost:8080

### 01-knowledge-health
GET {{knowledgeBaseUrl}}/actuator/health

> {%
  client.test("Knowledge Service is UP", function() {
    client.assert(response.status === 200, "knowledge health must be 200");
  });
%}

### 02-ticket-health
GET {{ticketBaseUrl}}/actuator/health

> {%
  client.test("Ticket Agent Service is UP", function() {
    client.assert(response.status === 200, "ticket health must be 200");
  });
%}

### 03-customer-health
GET {{customerBaseUrl}}/actuator/health

> {%
  client.test("Customer BFF is UP", function() {
    client.assert(response.status === 200, "customer health must be 200");
  });
%}

### 04-prometheus-is-not-public
GET {{ticketBaseUrl}}/actuator/prometheus

> {%
  client.test("Prometheus endpoint is not anonymously exposed", function() {
    client.assert(response.status === 401, "anonymous metrics request must be rejected");
  });
%}

### 05-invalid-input-has-stable-client-error
POST {{customerBaseUrl}}/api/v1/customer/consultations/answers
Content-Type: application/json

{"question":""}

> {%
  client.test("Invalid input is rejected before a model call", function() {
    client.assert(response.status === 400, "blank question must return 400");
  });
%}
